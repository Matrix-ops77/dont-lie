.ruff_cache/
.coverage
htmlcov/

# Local Don't-Lie state
vault.db
vault.db-*
*.sqlite
*.sqlite-*
.dontlie/

# Cryptographic material — NEVER commit
keys/
**/keys/
*.key
*.pub
key_id
dontlie.key
dontlie.pub
# Note: the file at onboard/dontlie-passive is the public user-facing
# entry point for the onboard package's passive instrumentation. It
# MUST be tracked in git so that `actions/checkout` ships it to CI
# runners. Do not add it back to .gitignore; if you find yourself
# wanting to ignore it, you are about to break CI. (Previous versions
# of this file listed it as ignored, which is exactly what caused
# the 33s CI flake that the local test suite could not reproduce.)

# Demo runtime artifacts (not source)
demo/work/
clients/demo/work/
**/demo/work/

# Receipt data and sample backlogs (may contain PII / real call data)
*.jsonl
*.jsonl.bak
receipt-report.html.bak
*.bak

# Editors / OS
.DS_Store
.idea/
.vscode/

# Demo build pipeline (source) and runtime artifacts (scratch)
demo/video/build_video.py
demo/video/frames/
demo/work_video/
RECIPTS_DEMO.mp4

# Re-include the build pipeline source even though the parent dir is
# otherwise ignored (this lets `git add demo/video/build_video.py` work).
!demo/video/
!demo/video/build_video.py
